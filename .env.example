# kubeseal-ui api environment
#
# Nothing in this repo loads a .env file. config.Load()
# (internal/config/config.go) reads process flags plus os.Getenv, so export
# these in the shell or let the container runtime inject them; copying this
# file to .env has no effect on its own.
#
# Values below are the code defaults unless the comment says otherwise.
# Required keys are blank with the reason stated. The Helm chart renders the
# server, OIDC, sealing, and GitOps keys (see
# ../charts/templates/deployment-api.yaml): KUBESEAL_API_PORT, LOG_LEVEL,
# OIDC_ISSUER, OIDC_CLIENT_ID, ENABLE_DECRYPT, KUBESEAL_CONTROLLER_NAMESPACE,
# KUBESEAL_ACTIVE_KEY_LABEL, and the GITOPS_* keys.
#
# Flags with the same meaning, and their defaults: -port 8080, -log-level
# info, -cert-url "", -fake-k8s true. A non-empty env var wins over its flag.

# --- Server ---------------------------------------------------------------

# TCP port to bind. Invalid value -> warning, flag default kept.
KUBESEAL_API_PORT=8080

# debug | info | warn | error. Anything else fails startup with exit 1.
LOG_LEVEL=info

# --- OIDC -----------------------------------------------------------------
# OIDC runs server-side (authorization code + PKCE). The SPA never sees a
# token, client id, or provider URL. Auth routes exist only when OIDC_ISSUER,
# OIDC_CLIENT_ID, OIDC_CLIENT_SECRET and OIDC_REDIRECT_URL are all set.
# The live path reads OIDC_ISSUER; OIDC_ISSUER_URL and COOKIE_SECURE belong to
# oidc.LoadConfig, which has no caller. CookieSecure is pinned to true.

# REQUIRED. Also gates /readyz.
OIDC_ISSUER=

# REQUIRED. Also gates /readyz.
OIDC_CLIENT_ID=

# REQUIRED. Keep out of Git; use a Secret.
OIDC_CLIENT_SECRET=

# REQUIRED. Must match the value registered with the provider.
OIDC_REDIRECT_URL=

# Space-separated (strings.Fields). Commas are not separators.
OIDC_SCOPES="openid profile email groups"

# Claim holding the user's groups; drives capability resolution.
OIDC_GROUPS_CLAIM=groups

# Claim used as the display username.
OIDC_USERNAME_CLAIM=preferred_username

# --- Session and CSRF -----------------------------------------------------

# REQUIRED. Without it no /api/v1 route is mounted at all (fail closed).
# 32+ random bytes; keep out of Git.
SESSION_SIGNING_KEY=

# Optional. Empty -> host-only cookie. Requests from another subdomain fail.
COOKIE_DOMAIN=

# REQUIRED in practice. Space-separated origins allowed to send state-changing
# requests. Empty leaves the built-in placeholder https://app.example.com, so
# the real origin is rejected with 403.
CSRF_TRUSTED_ORIGINS="https://kubeseal-ui.example.com"

# --- Kubernetes and sealing ----------------------------------------------

# "true" enables reveal/decrypt. Any other value, including "1", is false.
ENABLE_DECRYPT=false

# Controller public certificate endpoint. Empty -> startup warning and every
# seal request fails.
KUBESEAL_CERT_URL=

# Namespace of the sealed-secrets controller. Empty -> cluster.
KUBESEAL_CONTROLLER_NAMESPACE=cluster

# Label selecting the active sealing key. Empty -> the built-in default below.
KUBESEAL_ACTIVE_KEY_LABEL=sealedsecrets.bitnami.com/sealed-secrets-key

# "true" uses the in-memory fake client. Any other value is false, and false
# requires in-cluster credentials plus the controller-private-key RBAC when
# ENABLE_DECRYPT=true.
FAKE_K8S_CLIENT=true

# --- GitOps delivery ------------------------------------------------------
# Delivery is enabled by GITOPS_ENABLED plus at least one namespace mapping.
# Disabled boots keep /gitops/dry-run and /gitops/deliver fail-closed: the
# routes exist but every namespace resolves "mapping not found".

# "true" builds the go-git transport and seeds namespace mappings at boot.
GITOPS_ENABLED=false

# Commit attribution. Empty values mean commits carry no author identity,
# which hosts may reject.
GITOPS_AUTHOR_NAME=kubeseal-ui
GITOPS_AUTHOR_EMAIL=

# Scratch dir for per-repository worktrees. Must be writable; the chart
# mounts an emptyDir at /tmp/kubeseal-ui.
GITOPS_WORKTREE_DIR=/tmp/kubeseal-ui/gitops

# Typed credentials, comma-separated auth_ref:mode:username:token_file.
# mode is https-token | ssh-agent | none. Tokens are read from the mounted
# file on every call, so rotating the Secret needs no restart. Never inline.
GITOPS_CREDENTIAL_REFS=platform-repo:https-token:kubeseal-ui:/var/run/secrets/git/platform/token

# Namespace policy, comma-separated
# namespace:repository:branch:path_template:auth_ref:mode[:adapter_name].
# Path templates use '-' in place of '/'. mode is direct | proposal; a
# proposal entry must name an adapter from GITOPS_PROPOSAL_ADAPTERS.
# Clients never supply repository, branch, path, or mode.
GITOPS_NAMESPACES=payments:org/platform-repo:main:clusters-{namespace}-{name}.yaml:platform-repo:direct

# Proposal adapters, comma-separated name:type:token_file[:base_url].
# type is github, which opens a pull request through the GitHub REST API
# with a fine-grained PAT (Contents: Read+Write, Metadata: Read). base_url
# overrides the API root for GitHub Enterprise. A namespace naming an
# adapter that is not listed here fails startup.
GITOPS_PROPOSAL_ADAPTERS=
